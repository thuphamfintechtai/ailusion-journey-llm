# cp .env.homelab.example .env.homelab
# Chạy: docker compose --env-file .env.homelab -f compose.homelab.yaml up -d --build
# SERVICE_API_KEY phải trùng với file cùng tên bên ailusion-journey-be.

SERVICE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=openai:gpt-4.1-mini
LLM_FORM_MODEL=openai:gpt-4.1-nano
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMS=1536

POSTGRES_USER=ailusion
POSTGRES_PASSWORD=
POSTGRES_DB=ailusion
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6381
API_HOST_PORT=8001

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ailusion-journey
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
