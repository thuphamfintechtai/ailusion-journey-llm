<mxfile host="drawio"><diagram id="chat" name="Luồng chat"><mxGraphModel dx="1950" dy="1640" grid="1" gridSize="10" guides="1" page="1" pageWidth="1940" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Một câu chat chạy qua đâu, dùng prompt nào&lt;/b&gt; &amp;nbsp;&lt;font style='font-size:13px' color='#666'&gt;FE :3000 → BE :8000 → LLM :8001 · gpt-4.1-mini · lọc tin vào form, đồng ý lập kế hoạch thì tự mở form&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1880" height="40" as="geometry"/></mxCell><mxCell id="lfe" value="&lt;b&gt;FRONTEND · Next.js&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="1560" as="geometry"/></mxCell><mxCell id="lbe" value="&lt;b&gt;BACKEND · FastAPI&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="320" height="1560" as="geometry"/></mxCell><mxCell id="lllm" value="&lt;b&gt;LLM SERVICE · LangGraph&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="440" height="1560" as="geometry"/></mxCell><mxCell id="linf" value="&lt;b&gt;LƯU TRỮ &amp;amp; MODEL&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1160" y="60" width="250" height="1560" as="geometry"/></mxCell><mxCell id="pa" value="&lt;b&gt;A · MỖI CÂU CHAT&lt;/b&gt; &amp;nbsp;— câu thường 1 lượt LLM · câu có thông tin chuyến đi 2 lượt · 0 tool MCP" style="rounded=1;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="98" width="1350" height="26" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;① Người dùng gõ câu chat&lt;/b&gt;&lt;br&gt;hoặc form → &lt;i&gt;Gửi phần đã điền&lt;/i&gt;&lt;br&gt;(còn thiếu mục, trợ lý hỏi tiếp)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="270" height="64" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;② chat.stream()&lt;/b&gt;&lt;br&gt;POST /api/v1/chat/stream&lt;br&gt;Bearer token · đọc SSE bằng fetch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="236" width="270" height="64" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;③ chat_service.stream_message&lt;/b&gt;&lt;br&gt;• thread có của user không&lt;br&gt;• thread mới → tạo Conversation&lt;br&gt;• lưu câu hỏi (role=human)&lt;br&gt;• lấy &lt;b&gt;20 tin gần nhất&lt;/b&gt; = history" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="222" width="290" height="104" as="geometry"/></mxCell><mxCell id="pgbe" value="&lt;b&gt;Postgres BE&lt;/b&gt;&lt;br&gt;conversations, messages&lt;br&gt;(lịch sử hiển thị)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1180" y="226" width="210" height="72" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;④ llm_client.stream_message&lt;/b&gt;&lt;br&gt;POST :8001/chat/stream&lt;br&gt;{message, thread_id, user_id, history}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="356" width="290" height="64" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;⑤ api/app.py · chat_stream&lt;/b&gt; · _turn_messages()&lt;br&gt;Redis còn giữ hội thoại → chỉ gửi câu hỏi mới&lt;br&gt;hết hạn → nạp lại history BE gửi + câu hỏi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="715" y="350" width="410" height="76" as="geometry"/></mxCell><mxCell id="rd" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;checkpointer (state graph)&lt;br&gt;agent_log (/events)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="210" height="76" as="geometry"/></mxCell><mxCell id="g" value="" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="712" y="452" width="416" height="566" as="geometry"/></mxCell><mxCell id="gl" value="&lt;b&gt;⑥ Graph chat&lt;/b&gt; · graphs/chat.py &amp;nbsp; START → &lt;b&gt;loc_tin&lt;/b&gt; → &lt;b&gt;tra_loi&lt;/b&gt; → END" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="722" y="456" width="400" height="22" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;loc_tin · ① Bộ lọc luật&lt;/b&gt; · chat_filter.check() · &lt;b&gt;0 LLM&lt;/b&gt;&lt;br&gt;tìm dấu hiệu: số ngày, số người, tiền, địa danh, ngày tháng,&lt;br&gt;dị ứng/ăn chay/xe lăn, phong cách, sở thích, phương tiện&lt;br&gt;+ ý muốn lập lộ trình (hoặc “ok” ngay sau lời mời)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="484" width="384" height="84" as="geometry"/></mxCell><mxCell id="d1" value="Qua bộ lọc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="588" width="180" height="74" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;loc_tin · ② update_trip_info&lt;/b&gt; · &lt;b&gt;1 LLM&lt;/b&gt; (structured)&lt;br&gt;[&lt;span style='background:#fff2cc'&gt;&lt;b&gt;TRIP_UPDATE&lt;/b&gt;&lt;/span&gt;, form đang lưu + câu trợ lý vừa nói&lt;br&gt;+ tin mới] → TripUpdate (form + &lt;b&gt;wants_plan&lt;/b&gt;)&lt;br&gt;→ merge: mục mới thay, trống thì giữ cũ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="690" width="384" height="96" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;loc_tin · ③ Quyết định mở form&lt;/b&gt;&lt;br&gt;&lt;b&gt;open_form&lt;/b&gt; = vừa đồng ý lập lộ trình (đủ hay thiếu đều mở)&lt;br&gt;&amp;nbsp;&amp;nbsp;hoặc đang chờ + vừa trả lời đủ 5 mục&lt;br&gt;wants_plan giữ khi còn thiếu · lưu form vào store" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="806" width="384" height="92" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;tra_loi&lt;/b&gt; · 1 LLM, stream&lt;br&gt;[&lt;span style='background:#fff2cc'&gt;&lt;b&gt;CHAT_SYSTEM + TRIP_STATE&lt;/b&gt;&lt;/span&gt;(form, mục thiếu,&lt;br&gt;&amp;nbsp;việc lượt này), *toàn bộ lịch sử thread]&lt;br&gt;&lt;font color='#9a7b00'&gt;việc lượt này: xem bảng 4 trường hợp →&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="918" width="384" height="90" as="geometry"/></mxCell><mxCell id="pgllm" value="&lt;b&gt;Postgres LLM · bảng store&lt;/b&gt;&lt;br&gt;chats/{thread}/trip: form&lt;br&gt;users/{uid}/profile: dị ứng,&lt;br&gt;ăn chay, xe lăn…" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="210" height="96" as="geometry"/></mxCell><mxCell id="oa" value="&lt;b&gt;OpenAI&lt;/b&gt;&lt;br&gt;gpt-4.1-mini" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="900" width="210" height="80" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;⑦ stream_reply&lt;/b&gt; (chỉ chữ của node tra_loi)&lt;br&gt;SSE: start → delta… → &lt;b&gt;{type:&amp;quot;trip&amp;quot;, info, missing,&lt;br&gt;wants_plan, open_form}&lt;/b&gt; → done" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="715" y="1046" width="410" height="76" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;⑧ _relay_and_save&lt;/b&gt;&lt;br&gt;chuyển nguyên byte về FE&lt;br&gt;hết stream → lưu câu trả lời&lt;br&gt;vào Postgres BE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="1046" width="290" height="76" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;⑨ Trang chat&lt;/b&gt;&lt;br&gt;hiện chữ dần · nhận sự kiện trip&lt;br&gt;open_form = true → &lt;b&gt;tự mở form&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="1046" width="270" height="76" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;⑩ TripFormSheet&lt;/b&gt; điền sẵn từ trip&lt;br&gt;mục bắt buộc trống: nhãn đỏ &lt;b&gt;cần điền&lt;/b&gt;&lt;br&gt;(điểm đến · ngày đi · ngân sách;&lt;br&gt;số ngày, số người luôn có)&lt;br&gt;→ đủ: nút &lt;b&gt;Lập lộ trình&lt;/b&gt;&lt;br&gt;→ thiếu: nút &lt;b&gt;Gửi phần đã điền&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="1152" width="270" height="120" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;⑪ Lập lộ trình&lt;/b&gt;&lt;br&gt;PUT trip-info (lưu bản xác nhận)&lt;br&gt;→ /plan?from=chat tự chạy&lt;br&gt;POST /plan (pipeline lộ trình)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="1300" width="270" height="84" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;⑫ chat_service.confirm_trip&lt;/b&gt;&lt;br&gt;→ PUT :8001/chat/{id}/trip&lt;br&gt;(hoặc POST /api/v1/plan khi chạy lộ trình)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="1300" width="290" height="84" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;⑬ confirm_trip&lt;/b&gt;&lt;br&gt;lưu form confirmed, hồ sơ lấy đúng danh sách yêu cầu&lt;br&gt;lượt chat sau dùng bản này · 0 LLM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="715" y="1300" width="410" height="84" as="geometry"/></mxCell><mxCell id="pb" value="&lt;b&gt;B · BẤM “ĐIỀN THÔNG TIN CHUYẾN ĐI” TAY&lt;/b&gt; &amp;nbsp;— đọc form đã lưu, 0 lượt LLM" style="rounded=1;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="1410" width="1350" height="26" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Mở form&lt;/b&gt; · chat.tripInfo()&lt;br&gt;GET /api/v1/chat/threads/{id}/trip-info&lt;br&gt;(vừa có sự kiện trip thì dùng luôn)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="1452" width="270" height="70" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;chat_service.trip_info&lt;/b&gt;&lt;br&gt;GET :8001/chat/{id}/trip&lt;br&gt;form trống + hội thoại cũ → POST /trip-info" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="1452" width="290" height="70" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;get_trip&lt;/b&gt;: đọc store → TripState (0 LLM)&lt;br&gt;hội thoại cũ chưa có form: &lt;b&gt;extract_trip_info&lt;/b&gt;&lt;br&gt;[&lt;span style='background:#fff2cc'&gt;&lt;b&gt;TRIP_INFO&lt;/b&gt;&lt;/span&gt;, 40 tin] · 1 LLM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="715" y="1452" width="410" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="đọc / ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="a3" target="pgbe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5r" value="đọc state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="a5" target="rd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a5" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="l1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="d1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9l" value="không → 0 LLM" style="text;html=1;fontSize=11;align=center;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="724" y="600" width="104" height="20" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="l4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="718" y="625"/><mxPoint x="718" y="963"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="1 LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.19;" edge="1" parent="1" source="l2" target="oa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="738"/><mxPoint x="1140" y="915"/></Array></mxGeometry></mxCell><mxCell id="e13" value="1 LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.79;" edge="1" parent="1" source="l4" target="oa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="đọc form (+hồ sơ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="l1" target="pgllm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="526"/></Array></mxGeometry></mxCell><mxCell id="e15" value="lưu form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#666666;exitX=1;exitY=0.48;entryX=0.5;entryY=1;" edge="1" parent="1" source="l3" target="pgllm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="850"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="g" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="open_form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a8" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#6c8ebf;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f1" target="a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="46" y="1212"/><mxPoint x="46" y="172"/></Array></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=1;entryY=0.6;" edge="1" parent="1" source="f4" target="pgllm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="1342"/><mxPoint x="1400" y="758"/></Array></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pp" value="&lt;b&gt;PROMPT ĐANG CHẠY&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf3;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1430" y="60" width="480" height="1560" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;CHAT_SYSTEM&lt;/font&gt;&lt;/b&gt; · prompts/chat_system.py&lt;br&gt;&lt;font color='#666'&gt;node tra_loi · mọi lượt chat&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Bối cảnh&lt;/b&gt; · trợ lý du lịch VN, 4 nhóm P1–P4, không có tool tra cứu.&lt;br&gt;&lt;b&gt;2. Bảng thông tin chuyến đi&lt;/b&gt; · đọc mọi tin nhắn (“3N2Đ”, “1tr”, “500k”); đã có thì &lt;b&gt;không hỏi lại&lt;/b&gt;.&lt;br&gt;&lt;b&gt;3. Trả lời trước, hỏi sau&lt;/b&gt; · xin gợi ý → gợi ý ngay, ≤2 câu hỏi; biết khá rõ thì hỏi có muốn lập lộ trình không.&lt;br&gt;&lt;b&gt;4. Form lập lộ trình&lt;/b&gt; · 5 mục bắt buộc; đồng ý → form tự mở, mục thiếu tô đỏ, liệt kê mục thiếu kèm ví dụ; đóng / gửi thiếu → hỏi tiếp trong chat; không tự viết lịch trình.&lt;br&gt;&lt;b&gt;5. Ngân sách&lt;/b&gt; · chia người/ngày, &amp;lt;300k → hỏi rõ cả chuyến hay mỗi người.&lt;br&gt;&lt;b&gt;6. Định dạng&lt;/b&gt; · Điểm tham quan / Món nên ăn / Chỗ ở; “mình – bạn”.&lt;br&gt;&lt;b&gt;7. Quy tắc khác&lt;/b&gt; · không bịa giá, giờ, SĐT.&lt;br&gt;&lt;b&gt;8. Ví dụ&lt;/b&gt; · Đà Lạt 3N2Đ: gợi ý → hỏi ngân sách → đồng ý lập lộ trình." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1445" y="100" width="450" height="262" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;TRIP_STATE&lt;/font&gt;&lt;/b&gt; · nối sau CHAT_SYSTEM&lt;br&gt;&lt;font color='#666'&gt;{form} · {missing} · {instruction} — loc_tin chọn 1 trong 4:&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;STATE_OPEN_FORM_MISSING&lt;/b&gt; — vừa đồng ý, còn thiếu&lt;br&gt;&amp;nbsp;→ báo form đã mở, liệt kê mục thiếu kèm ví dụ, chỉ hỏi mục bắt buộc&lt;br&gt;&lt;br&gt;&lt;b&gt;STATE_OPEN_FORM&lt;/b&gt; — form đủ (vừa đồng ý / vừa trả lời đủ)&lt;br&gt;&amp;nbsp;→ tóm tắt 2–4 câu, mời xem lại rồi bấm Lập lộ trình; gợi ý nhóm chỉ khi có căn cứ&lt;br&gt;&lt;br&gt;&lt;b&gt;STATE_ASK_MISSING&lt;/b&gt; — đã muốn lập, vẫn thiếu (đóng / gửi thiếu)&lt;br&gt;&amp;nbsp;→ hỏi đủ mục thiếu trong chat, trả lời đủ thì form mở lại&lt;br&gt;&lt;br&gt;&lt;b&gt;STATE_CHATTING&lt;/b&gt; — chưa muốn lập lộ trình&lt;br&gt;&amp;nbsp;→ chat bình thường, dùng form để không hỏi lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1445" y="376" width="450" height="262" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;TRIP_UPDATE&lt;/font&gt;&lt;/b&gt; · prompts/trip_update.py&lt;br&gt;&lt;font color='#666'&gt;update_trip_info · chỉ khi qua bộ lọc · biến {today}&lt;/font&gt;&lt;br&gt;&lt;br&gt;Vào: form hiện tại (JSON) + câu trợ lý vừa nói + tin mới&lt;br&gt;Ra: &lt;b&gt;form đầy đủ&lt;/b&gt; + &lt;b&gt;wants_plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Giữ mục cũ không nhắc tới; đổi ý → lấy ý mới&lt;br&gt;• Chỉ ghi điều người dùng nói / đồng ý; không đoán&lt;br&gt;• days, start_date (quy đổi từ {today}), adults / children / seniors, budget_million (tổng cả đoàn) + budget_hard&lt;br&gt;• persona p1–p4 khi khớp rõ; access, interests, transport, pace trong giá trị cho sẵn&lt;br&gt;• &lt;b&gt;wants_plan&lt;/b&gt; = muốn lập lộ trình ngay, hoặc đồng ý khi trợ lý vừa mời" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1445" y="652" width="450" height="236" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;TRIP_INFO&lt;/font&gt;&lt;/b&gt; · prompts/trip_info.py&lt;br&gt;&lt;font color='#666'&gt;extract_trip_info · chỉ cho hội thoại cũ chưa lưu form&lt;/font&gt;&lt;br&gt;&lt;br&gt;Đọc cả 40 tin nhắn một lần → TripInfo. 10 quy tắc giống TRIP_UPDATE, không có wants_plan." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1445" y="902" width="450" height="104" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Không chạy trong luồng chat&lt;/b&gt;&lt;br&gt;Prompt chiến lược P1–P4 và PLAN_EXPLAIN chỉ chạy ở &lt;b&gt;POST /plan&lt;/b&gt; (sau khi bấm Lập lộ trình). Chat không gọi tool MCP." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1445" y="1020" width="450" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>