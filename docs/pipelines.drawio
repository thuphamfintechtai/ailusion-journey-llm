  <diagram name="POST /plan" id="5"><mxGraphModel dx="1903" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1" value="POST /plan · người dùng điền form, nhận về một lộ trình" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p2" value="2 lượt gọi LLM (chiến lược theo nhóm P1–P4 + giải thích) · 10–15 lượt gọi tool MCP · 3 phương án: Cân bằng / Tiết kiệm / Trải nghiệm" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="-12" width="1200" height="24" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&quot;font-size:11px&quot;&gt;01 NHẬN FORM&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1f4f8f&quot;&gt;&lt;b&gt;api/app.py&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PlanRequest · 8 nhóm, 29 trường&lt;br&gt;trống → mặc định + giả định&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="160" height="120" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style=&quot;font-size:11px&quot;&gt;02 CHUẨN HOÁ&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#2d6a2d&quot;&gt;&lt;b&gt;normalize.py&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ràng buộc cứng / mềm&lt;br&gt;ngân sách · ngày · toạ độ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="170" 