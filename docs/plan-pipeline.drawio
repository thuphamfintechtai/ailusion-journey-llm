<mxfile host="drawio"><diagram id="plan" name="Lập lộ trình"><mxGraphModel dx="2410" dy="1736" grid="1" gridSize="10" guides="1" page="1" pageWidth="2410" pageHeight="1736" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Pipeline lập lộ trình — 17 bước, 5 làn&lt;/b&gt; &amp;nbsp; POST :8001/itinerary · POST :8001/chat/{id}/plan · thường 4–6 lượt gpt-4.1-mini, ~$0.01 mỗi lộ trình · src/ailusion/itinerary/" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi làn một thư mục / file. LLM chỉ đề xuất kèm bằng chứng (câu trích, link); code kiểm rồi mới nhận, sai thì sửa 1 lần, vẫn sai thì dùng cách của code. Nối các bước: itinerary/pipeline.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1900" height="30" as="geometry"/></mxCell><mxCell id="laneC" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="1596" as="geometry"/></mxCell><mxCell id="lanehC" value="COORDINATOR · code, không LLM&lt;br/&gt;itinerary/coordinator/" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="44" as="geometry"/></mxCell><mxCell id="laneI" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="250" height="1596" as="geometry"/></mxCell><mxCell id="lanehI" value="INTAKE&lt;br/&gt;agents/intake.py" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="250" height="44" as="geometry"/></mxCell><mxCell id="laneE" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="250" height="1596" as="geometry"/></mxCell><mxCell id="lanehE" value="EXPERIENCE&lt;br/&gt;agents/experience.py" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="250" height="44" as="geometry"/></mxCell><mxCell id="laneB" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="250" height="1596" as="geometry"/></mxCell><mxCell id="lanehB" value="BUDGET&lt;br/&gt;agents/budget.py" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="250" height="44" as="geometry"/></mxCell><mxCell id="laneP" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="100" width="250" height="1596" as="geometry"/></mxCell><mxCell id="lanehP" value="PLANNER&lt;br/&gt;agents/planner.py" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="100" width="250" height="44" as="geometry"/></mxCell><mxCell id="laneD" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1710" y="100" width="250" height="1596" as="geometry"/></mxCell><mxCell id="lanehD" value="DECISION&lt;br/&gt;agents/decision.py" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1710" y="100" width="250" height="44" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;① nhan_form&lt;/b&gt; · profile.py&lt;br/&gt;form từ chat hoặc trang /plan (chỉ ô đã điền)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="170" width="536" height="84" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;② doc_loi_nhan&lt;/b&gt;&lt;br/&gt;đọc lời nhắn → ô còn trống&lt;br/&gt;câu trích phải có thật · &lt;b&gt;0–1 LLM&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="642" y="274" width="226" height="84" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;③ phan_nhom&lt;/b&gt; · profile.py&lt;br/&gt;nhóm P1–P4 bằng luật B0→B4 · giờ rảnh từng ngày" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="378" width="536" height="84" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;④ hoi_lai?&lt;/b&gt; · thiếu ý quan trọng&lt;br/&gt;→ trả câu hỏi kèm nút (need_info), dừng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="482" width="536" height="84" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;⑤ tim_kiem&lt;/b&gt; · search.py&lt;br/&gt;chỗ chơi, quán, chỗ ở, lễ hội, thời tiết, thiên tai&lt;br/&gt;DB trước; Tavily / SerpApi chỉ khi DB thiếu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="586" width="536" height="84" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;⑥ loc&lt;/b&gt; · filter.py&lt;br/&gt;bỏ: đóng cửa, thiếu nhu cầu, cửa hàng, xa &amp;gt; 60 km,&lt;br/&gt;chỗ trùng tên · từ khoá mục đích → tự nhận hợp ý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="690" width="536" height="84" as="geometry"/></mxCell><mxCell id="s6a" value="&lt;b&gt;⑥a xac_minh&lt;/b&gt;&lt;br/&gt;đọc review (DB trước) → hợp mục đích?&lt;br/&gt;câu trích phải có trong review · &lt;b&gt;0–1 LLM&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="912" y="794" width="226" height="84" as="geometry"/></mxCell><mxCell id="s6b" value="&lt;b&gt;⑥b xac_minh&lt;/b&gt;&lt;br/&gt;web_search giá vé → code mở lại link,&lt;br/&gt;số tiền phải có trên trang · &lt;b&gt;0–1 LLM&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1182" y="794" width="226" height="84" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;⑦ cham&lt;/b&gt; · score.py&lt;br/&gt;sao tin được (Bayes theo dữ liệu, MCP tính; thiếu thì Hoeffding) · thời gian ở lại · giá ước&lt;br/&gt;chọn chỗ ở: tầng không bị trội, xếp theo nhóm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="898" width="536" height="84" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;⑧ chot_danh_sach&lt;/b&gt; · score.py&lt;br/&gt;ma trận phút đi (≤ 25 điểm, thiếu thì ước)&lt;br/&gt;sức chứa ngày · &lt;b&gt;chia chỗ cho từng ngày&lt;/b&gt; (không lặp)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="1002" width="536" height="84" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;⑨ xep_lich&lt;/b&gt;&lt;br/&gt;≥ 3 lịch / ngày, chỉ dùng chỗ của ngày&lt;br/&gt;sai luật → sửa 1 lần · &lt;b&gt;1 LLM / 4 ngày&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1452" y="1106" width="226" height="84" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;⑩–⑪ kiem_lich&lt;/b&gt; · simulate.py&lt;br/&gt;code đặt quán vào giờ trưa / tối · chạy thử 2 lần&lt;br/&gt;(ở ít / ở lâu) → ok / risky / warn / fail" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="1210" width="536" height="84" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;⑫–⑮ xep_hang, ghep&lt;/b&gt; · rank.py&lt;br/&gt;gắn nhãn lịch kém hơn mọi mặt · xếp theo nhóm&lt;br/&gt;ghép ≤ 3 phương án ít lặp · kiểm ngân sách" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="1314" width="536" height="84" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;⑯ quyet_dinh&lt;/b&gt;&lt;br/&gt;chốt phương án + lời giải thích&lt;br/&gt;không thêm số, không lộ mã · &lt;b&gt;1 LLM&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1722" y="1418" width="226" height="84" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b&gt;⑰ tra_ket_qua&lt;/b&gt; · response.py&lt;br/&gt;ItineraryResponse + link Google Maps (dựng bằng code)&lt;br/&gt;+ lộ trình dạng chữ nối vào chat" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="1522" width="536" height="84" as="geometry"/></mxCell><mxCell id="e_skip2" value="không có lời nhắn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s1_s2" value="có lời nhắn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s2_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.8;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s3_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s4_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s5_s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s6_s6a" value="chưa rõ hợp ý (≤ 8)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;" edge="1" parent="1" source="s6" target="s6a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s6_s6b" value="chưa có giá (≤ 5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;" edge="1" parent="1" source="s6" target="s6b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s6a_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="s6a" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s6b_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.7;" edge="1" parent="1" source="s6b" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s7_s8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s8_s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s9_s10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s10_s12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s10" target="s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s12_s16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s12" target="s16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s16_s17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s16" target="s17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_fix" value="lệch → Planner sửa 1 lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="s10" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="end4" value="&lt;b&gt;status = need_info&lt;/b&gt;&lt;br/&gt;câu hỏi H1–H5 kèm nút chọn&lt;br/&gt;user trả lời → gửi lại form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="642" y="482" width="226" height="84" as="geometry"/></mxCell><mxCell id="e_end4" value="còn thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="end4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_src" value="&lt;b&gt;Nguồn dữ liệu (MCP :8002)&lt;/b&gt;&lt;br/&gt;• DB đã cào (miễn phí): browse_places, find_stays, check_opening_hours, check_place_needs, find_festivals, get_place_reviews / get_place_details (source=auto|db)&lt;br/&gt;• Tốn quota, chỉ khi DB thiếu: search_events (Tavily), search_hotels / search_places (SerpApi)&lt;br/&gt;• Luôn gọi: web_search + fetch_page (Agent Budget, ≤ 5 chỗ), distance_matrix (Vietmap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1990" y="100" width="380" height="150" as="geometry"/></mxCell><mxCell id="n_cost" value="&lt;b&gt;Chặn chi phí LLM&lt;/b&gt;&lt;br/&gt;• không bật thinking, trần token đầu ra theo việc&lt;br/&gt;• thử lại ≤ 1 lần, sửa ≤ 1 lần mỗi agent&lt;br/&gt;• Intake / Experience / Budget chỉ chạy khi cần&lt;br/&gt;• tool lỗi không làm sập lộ trình (ctx.tool trả lỗi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1990" y="270" width="380" height="105" as="geometry"/></mxCell><mxCell id="n_rules" value="&lt;b&gt;Luật code quan trọng&lt;/b&gt;&lt;br/&gt;• mỗi ngày tối đa 1 chỗ mỗi loại; spa 1 chỗ / 2 ngày&lt;br/&gt;• mỗi chỗ chơi chỉ ở 1 ngày (chia sẵn ở ⑧)&lt;br/&gt;• quán ăn trong 11:00–13:30 / 18:00–20:00 (code tự đặt ở ⑩)&lt;br/&gt;• giờ nghỉ trưa của từng chỗ được tính khi chạy thử&lt;br/&gt;• thiếu giá → ước theo chỗ cùng loại / bảng loại, ghi rõ &quot;ước&quot;&lt;br/&gt;• thiếu phút đi → ước theo đường chim bay, có ghi chú" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1990" y="395" width="380" height="140" as="geometry"/></mxCell><mxCell id="n_shared" value="&lt;b&gt;shared/&lt;/b&gt;&lt;br/&gt;form.py — B1 form + bảng luật · models.py — Place, DayPlan, state&lt;br/&gt;context.py — Ctx: tool / LLM / log · tools.py — đọc kết quả tool&lt;br/&gt;llm.py — trần token, kiểm câu trích · math.py — Hoeffding (dự phòng), Pareto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1990" y="555" width="380" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>