<mxfile host="drawio"><diagram id="plan" name="Lập lộ trình"><mxGraphModel dx="1600" dy="1620" grid="1" gridSize="10" guides="1" page="1" pageWidth="1560" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Luồng lập lộ trình — Coordinator + 3 agent&lt;/b&gt; &amp;nbsp;&lt;font style='font-size:13px' color='#666'&gt;POST /chat/{thread}/plan · LLM service :8001 · gpt-4.1-mini · 5–9 lượt LLM, ~22–26 lượt tool&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;USER INPUT&lt;/b&gt; · chat → đồng ý lập kế hoạch → form tự mở → bấm &lt;b&gt;Lập lộ trình&lt;/b&gt;&lt;br&gt;&lt;font color='#555'&gt;điểm đến, ngày, đoàn, ngân sách, sở thích, yêu cầu bắt buộc, nhóm P1–P4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="60" width="500" height="64" as="geometry"/></mxCell><mxCell id="ctxg" value="" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1160" height="150" as="geometry"/></mxCell><mxCell id="ctxl" value="&lt;b&gt;① TRIP CONTEXT&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="154" width="400" height="22" as="geometry"/></mxCell><mxCell id="bc" value="&lt;b&gt;boi_canh&lt;/b&gt; · code + tool · &lt;b&gt;0 LLM&lt;/b&gt;&lt;br&gt;geocode_vn · vn_calendar · weather_forecast (theo giờ) · find_festivals&lt;br&gt;→ &lt;b&gt;Weather · Preferences · Budget · Time · Transportation · Constraints · Interests&lt;/b&gt;&lt;br&gt;&lt;font color='#555'&gt;bình quân ngân sách/người/ngày, giờ trống từng ngày, mưa sáng/chiều/tối&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="182" width="560" height="104" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;chien_luoc&lt;/b&gt; · prompt riêng theo nhóm P1–P4&lt;br&gt;số điểm/ngày, dự phòng, hạng phòng, tiền ăn, né đông, chặng tối đa…&lt;br&gt;&lt;font color='#555'&gt;bị ép vào khoảng cho phép của nhóm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="182" width="530" height="104" as="geometry"/></mxCell><mxCell id="b1" value="LLM #1" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="188" width="74" height="22" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="u" target="ctxg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="bc" target="cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ag" value="" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1160" height="250" as="geometry"/></mxCell><mxCell id="agl" value="&lt;b&gt;② BA AGENT SONG SONG&lt;/b&gt; · mỗi agent một bộ tool riêng · LLM chỉ chọn trên danh mục có mã" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="334" width="700" height="22" as="geometry"/></mxCell><mxCell id="pl" value="&lt;b&gt;🗺️ Planner&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tool:&lt;/b&gt; browse_places (phổ biến, đánh giá cao, theo sở thích, theo chiến lược) · check_opening_hours từng ngày&lt;br&gt;&lt;b&gt;Thiếu dữ liệu:&lt;/b&gt; browse quanh toạ độ 10 km (miễn phí) → search_places ≤ 2 (tốn quota)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ra:&lt;/b&gt; danh mục &lt;b&gt;D…&lt;/b&gt; → chia ngày theo khu, thứ tự đi, điểm dự phòng khi mưa" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="360" height="200" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;🍜 Experience&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tool:&lt;/b&gt; browse_places nhà hàng, đặc sản, cà phê, chợ đêm, quán chay&lt;br&gt;&lt;b&gt;Thiếu dữ liệu:&lt;/b&gt; quanh toạ độ → search_places ≤ 2&lt;br&gt;&lt;br&gt;&lt;b&gt;Ra:&lt;/b&gt; danh mục &lt;b&gt;A…&lt;/b&gt; (quán), &lt;b&gt;T…&lt;/b&gt; (trải nghiệm) → bữa trưa/tối, &lt;i&gt;món nên thử&lt;/i&gt;, cà phê, chợ đêm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="440" y="364" width="360" height="200" as="geometry"/></mxCell><mxCell id="bu" value="&lt;b&gt;💰 Budget&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tool:&lt;/b&gt; search_hotels (giá thật đúng ngày, đủ dải giá) · get_route · search_flights&lt;br&gt;&lt;br&gt;&lt;b&gt;Ra:&lt;/b&gt; danh mục &lt;b&gt;K…&lt;/b&gt; → chỗ ở cho từng phương án, tiền ăn/bữa, chỗ cắt giảm, cảnh báo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="364" width="360" height="200" as="geometry"/></mxCell><mxCell id="b2" value="LLM #2" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="336" y="372" width="74" height="22" as="geometry"/></mxCell><mxCell id="b3" value="LLM #3" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="372" width="74" height="22" as="geometry"/></mxCell><mxCell id="b4" value="LLM #4" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="372" width="74" height="22" as="geometry"/></mxCell><mxCell id="e2" value="Send ×3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cl" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cl" target="pl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="310"/><mxPoint x="240" y="310"/></Array></mxGeometry></mxCell><mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cl" target="bu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="310"/><mxPoint x="1000" y="310"/></Array></mxGeometry></mxCell><mxCell id="q1" value="&lt;b&gt;❓ Câu hỏi mentor 1&lt;/b&gt;&lt;br&gt;Experience chọn quán khi &lt;b&gt;chưa biết Planner đi khu nào&lt;/b&gt; → Coordinator phải tự ghép quán gần lịch.&lt;br&gt;&lt;br&gt;A. giữ song song&lt;br&gt;B. tuần tự: Planner → Experience&lt;br&gt;C. lai: tool song song, chỉ bước LLM tuần tự" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#e05252;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="364" width="300" height="200" as="geometry"/></mxCell><mxCell id="eq1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#e05252;endArrow=open;" edge="1" parent="1" source="q1" target="bu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="th" value="&lt;b&gt;③ tong_hop&lt;/b&gt; · code · gộp dữ liệu 3 agent thành gói bối cảnh, loại nơi vi phạm ràng buộc cứng&lt;br&gt;&lt;font color='#b85450'&gt;0 điểm tham quan → báo lỗi rõ ràng (422), không trả lịch rỗng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="610" width="500" height="70" as="geometry"/></mxCell><mxCell id="e3a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pl" target="th"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="595"/><mxPoint x="620" y="595"/></Array></mxGeometry></mxCell><mxCell id="e3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ex" target="th"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="bu" target="th"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="595"/><mxPoint x="620" y="595"/></Array></mxGeometry></mxCell><mxCell id="td" value="&lt;b&gt;④ 🧠 thao_luan&lt;/b&gt; · Coordinator gộp 3 đề xuất → &lt;b&gt;bản nháp 3 phương án&lt;/b&gt;&lt;br&gt;&lt;font color='#555'&gt;xử lý xung đột: ràng buộc cứng &gt; ngân sách cứng &gt; nhịp độ &gt; sở thích&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="710" width="500" height="64" as="geometry"/></mxCell><mxCell id="b5" value="LLM #5" style="rounded=1;arcSize=50;html=1;fillColor=#b85450;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="786" y="716" width="74" height="22" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="th" target="td"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="xn" value="&lt;b&gt;⑤ xep_nhap&lt;/b&gt; · code xếp giờ thật: quãng đường, giờ mở cửa, nghỉ trưa, giờ về, chi phí" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="800" width="500" height="56" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="td" target="xn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dz" value="Bản nháp có vấn đề?&lt;br&gt;&lt;font style='font-size:10px'&gt;vượt ngân sách · trễ giờ · bỏ điểm&lt;br&gt;PLAN_CRITIQUE=auto&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="880" width="300" height="96" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="xn" target="dz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cg" value="" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1160" height="150" as="geometry"/></mxCell><mxCell id="cgl" value="&lt;b&gt;⑥ PHẢN BIỆN&lt;/b&gt; · mỗi agent soát bản nháp theo góc của mình (chỉ nhận danh mục của mình)" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="1004" width="600" height="22" as="geometry"/></mxCell><mxCell id="c1" value="🗺️ Planner: đi qua lại xa? ngày quá dày/trống? điểm bị bỏ?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1034" width="360" height="60" as="geometry"/></mxCell><mxCell id="bc0" value="LLM #6" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="336" y="1100" width="74" height="22" as="geometry"/></mxCell><mxCell id="c2" value="🍜 Experience: quán xa lịch? lặp món? thiếu đặc sản?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1034" width="360" height="60" as="geometry"/></mxCell><mxCell id="bc1" value="LLM #7" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="1100" width="74" height="22" as="geometry"/></mxCell><mxCell id="c3" value="💰 Budget: vượt ngân sách? 3 phương án đủ khác giá?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1034" width="360" height="60" as="geometry"/></mxCell><mxCell id="bc2" value="LLM #8" style="rounded=1;arcSize=50;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="1100" width="74" height="22" as="geometry"/></mxCell><mxCell id="e7" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="dz" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="dz" target="c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="990"/><mxPoint x="240" y="990"/></Array></mxGeometry></mxCell><mxCell id="e7b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="dz" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="990"/><mxPoint x="1000" y="990"/></Array></mxGeometry></mxCell><mxCell id="ch" value="&lt;b&gt;⑦ 🧠 chot&lt;/b&gt; · Coordinator nhận phản biện → &lt;b&gt;bản chốt&lt;/b&gt; + lời tóm tắt dễ đọc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1170" width="500" height="56" as="geometry"/></mxCell><mxCell id="b9" value="LLM #9" style="rounded=1;arcSize=50;html=1;fillColor=#b85450;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="786" y="1176" width="74" height="22" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c1" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1160"/><mxPoint x="620" y="1160"/></Array></mxGeometry></mxCell><mxCell id="e8b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c3" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="1160"/><mxPoint x="620" y="1160"/></Array></mxGeometry></mxCell><mxCell id="e9l" value="không → bản nháp dùng làm bản chốt (5 LLM)" style="text;html=1;fontSize=11;align=left;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="780" y="900" width="250" height="22" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dz" target="xl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="928"/><mxPoint x="1210" y="1283"/></Array></mxGeometry></mxCell><mxCell id="xl" value="&lt;b&gt;⑧ xep_lich ⇄ kiem_tra&lt;/b&gt; · code xếp lại theo bản chốt; vượt ngân sách cứng → siết (≤ 2 lần, không gọi LLM)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1256" width="500" height="56" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ch" target="xl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rr" value="&lt;b&gt;⑨ rui_ro_chon&lt;/b&gt; · mô phỏng trễ giờ 1000 lần · TOPSIS theo trọng số nhóm · plan_day_route → chọn phương án đề xuất" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1338" width="500" height="56" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="xl" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gt" value="&lt;b&gt;⑩ giai_thich&lt;/b&gt; · code ghép lời giải thích từ bản chốt (không %) · ghi token + chi phí ước tính" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1420" width="500" height="56" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="rr" target="gt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fi" value="&lt;b&gt;FINAL ITINERARY&lt;/b&gt; · &lt;b&gt;3 phương án&lt;/b&gt; Cân bằng / Tiết kiệm / Trải nghiệm + biên bản thảo luận&lt;br&gt;→ lưu Postgres (&lt;i&gt;messages.plan&lt;/i&gt;) → hiện ngay trong chat, tải lại trang vẫn còn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1504" width="600" height="80" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="gt" target="fi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2" value="&lt;b&gt;❓ Câu hỏi mentor 2&lt;/b&gt;&lt;br&gt;Giữ 3 phương án, hay 1 lộ trình tốt + lựa chọn thay thế từng chỗ?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#e05252;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="1504" width="300" height="80" as="geometry"/></mxCell><mxCell id="eq2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;strokeColor=#e05252;endArrow=open;" edge="1" parent="1" source="q2" target="fi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg" value="&lt;b&gt;Chặn chi phí&lt;/b&gt;&lt;br&gt;• Không bật thinking (llm.no_thinking)&lt;br&gt;• Trần token đầu ra mỗi lượt&lt;br&gt;• Thử lại tối đa 1 lần&lt;br&gt;• Không vòng lặp nào gọi LLM&lt;br&gt;• search_places (quota) chỉ khi thiếu dữ liệu, ≤ 4/lộ trình&lt;br&gt;&lt;br&gt;&lt;span style='background:#e1d5e7'&gt;&amp;nbsp;LLM&amp;nbsp;&lt;/span&gt; &lt;span style='background:#d5e8d4'&gt;&amp;nbsp;code&amp;nbsp;&lt;/span&gt; &lt;span style='background:#f8cecc'&gt;&amp;nbsp;coordinator&amp;nbsp;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="300" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>