# Sao chép thành .env rồi điền key:  cp .env.example .env
# .env đã nằm trong .gitignore — không commit file này.

APP_ENV=development

# Bố trí cổng khi chạy cùng repo ailusion-journey-be trên một máy:
#   5432 Postgres cài sẵn trên máy (nếu có)  |  5433 Postgres repo này  |  5434 Postgres BE
#   6379 Redis repo này                      |  6380 Redis BE
#   8001 API repo này                        |  8000 API BE
# Cổng nào trống thì cứ để mặc định bên dưới.

# ============================================================ LLM (Gemini + OpenAI)
# Dự án chỉ dùng hai nhà cung cấp này, không dùng Anthropic.
# Gemini — lấy key: aistudio.google.com/apikey
# (code tự chép sang GOOGLE_API_KEY cho langchain-google-genai, không cần khai hai lần)
GEMINI_API_KEY=
# OpenAI — lấy key: platform.openai.com/api-keys
OPENAI_API_KEY=
# Model cho chat và pipeline lập lộ trình, dạng provider:model
#   Gemini: google_genai:gemini-flash-latest, google_genai:gemini-2.5-pro
#   OpenAI: openai:gpt-4.1-mini
LLM_MODEL=openai:gpt-4.1-mini
# Model nhỏ cho lượt lọc tin nhắn vào form chuyến đi (chạy trước câu trả lời; nhanh, rẻ).
LLM_FORM_MODEL=openai:gpt-4.1-nano

# ============================================================ LangSmith (Cloud)
# Lấy key: smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ailusion-journey-dev
# US: https://api.smith.langchain.com   |   EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================ Langfuse (Cloud)
# Lấy key: Langfuse -> Project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | JP: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# 1.0 = trace mọi lượt; giảm khi lên production
LANGFUSE_SAMPLE_RATE=1.0

# Che PII (sđt, email, CCCD, hộ chiếu, số thẻ) trước khi gửi trace lên cả hai nơi
PII_MASKING=true

# ============================================================ Redis — bộ nhớ ngắn hạn
REDIS_HOST_PORT=6381
REDIS_URL=redis://localhost:6381/0
# TTL checkpoint + stream nhật ký (phút). 1440 = 24 giờ
CHECKPOINT_TTL_MINUTES=1440
TOOL_CACHE_DEFAULT_TTL_SECONDS=900
AGENT_LOG_MAXLEN=5000

# ============================================================ Postgres — bộ nhớ dài hạn
POSTGRES_USER=ailusion
POSTGRES_PASSWORD=ailusion
POSTGRES_DB=ailusion
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://ailusion:ailusion@localhost:5433/ailusion
# TLS tới Postgres: prefer (Docker ở máy, SSL tắt) | require (DB đi qua internet) | verify-full
# (kiểm cả chứng chỉ, cần cert do CA ký). DATABASE_URL đã ghi sẵn ?sslmode=... thì giữ theo URL.
PG_SSLMODE=prefer
# EMBEDDING_MODEL=none nếu chưa muốn tìm kiếm ngữ nghĩa trong bộ nhớ dài hạn.
# Đổi model thì phải đổi EMBEDDING_DIMS cho khớp (và tạo lại bảng store_vectors):
#   openai:text-embedding-3-small      -> 1536
#   google_genai:gemini-embedding-001  -> 3072
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMS=1536

# ============================================================ Tool bên ngoài
# MCP server Ailusion Journey (39 tool: địa điểm, thời tiết, giá, tuyến đường, lịch VN...)
MCP_URL=http://localhost:8002/mcp
SERPAPI_API_KEY=
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# OSRM (tuỳ chọn, `make osrm-prepare` rồi `make osrm-up`)
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest
OSRM_CAR_PORT=5001
OSRM_FOOT_PORT=5002
OSRM_CAR_URL=http://localhost:5001
OSRM_FOOT_URL=http://localhost:5002

# ============================================================ Bảo vệ service
# Khoá dùng chung với backend (LLM_SERVICE_KEY bên BE): mọi route trừ /health cần header
# X-Service-Key đúng khoá này. Tạo bằng `openssl rand -hex 32`. Bỏ trống = không kiểm.
SERVICE_API_KEY=
